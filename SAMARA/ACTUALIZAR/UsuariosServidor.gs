// Acceso de SAMARA. Credenciales y sesiones nunca se guardan en las colecciones del cliente.
const AUTH_USERS_PREFIX_='SAMARA_USER_';
const AUTH_ITERATIONS_=600000;
var authRendering_=false;
function authProps_(){return PropertiesService.getScriptProperties();}
function authHash_(value){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value))).replace(/=+$/,'');}
function authSecret_(){const p=authProps_();let secret=p.getProperty('SAMARA_AUTH_SECRET');if(!secret){secret=Utilities.getUuid()+Utilities.getUuid();p.setProperty('SAMARA_AUTH_SECRET',secret);}return secret;}
function authVerifier_(key,salt){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(salt+':'+key,authSecret_()));}
function authEqual_(a,b){a=String(a||'');b=String(b||'');let diff=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)diff|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return diff===0;}
function authUsers_(){const all=authProps_().getProperties();return Object.keys(all).filter(key=>key.startsWith(AUTH_USERS_PREFIX_)).map(key=>JSON.parse(all[key])).sort((a,b)=>(a.role==='admin'?0:1)-(b.role==='admin'?0:1)||a.name.localeCompare(b.name,'es')||a.username.localeCompare(b.username)||a.id.localeCompare(b.id));}
const AUTH_MODULES_=['dashboard','program','courses','matrix','people','instructors','attendance','cmcap','reports'];
const AUTH_COLLECTION_MODULES_={'samara.courseProgram.v1':'program','samara.courses.v2':'courses','samara.courseDepartments.v1':'courses','samara.matrixDepartments.v1':'matrix','samara.positions.v2':'matrix','samara.matrixPositions.v2':'matrix','samara.occupationCatalog.v1':'matrix','samara.employees.v2':'people','samara.demoEmployees.v1':'people','samara.instructors.v1':'instructors','samara.attendance.v1':'attendance','samara.attendanceMigration.v1':'attendance','samara.cmcap.v2':'cmcap','samara.legalRepresentative.v1':'cmcap'};
function authPermissions_(user){const result={};AUTH_MODULES_.forEach(module=>{result[module]=user.role==='admin'?'edit':user.permissions?user.permissions[module]||'none':module==='dashboard'?'view':'edit';});return result;}
function authCan_(user,module,edit){if(user.role==='admin')return true;const level=authPermissions_(user)[module];return edit?level==='edit':level==='edit'||level==='view';}
function authModule_(token,module,edit){const user=authRequire_(token);if(!authCan_(user,module,edit))throw Error('PERMISSION_DENIED: No tienes permiso de '+(edit?'edición':'consulta')+' en '+module+'.');return user;}
function authValidatePermissions_(value,role,previous){if(role==='admin')return authPermissions_({role:'admin'});if(value==null)return authPermissions_(previous||{role:'coordinator'});if(typeof value!=='object'||Array.isArray(value)||Object.keys(value).some(key=>!AUTH_MODULES_.includes(key)))throw Error('Permisos inválidos.');const result={};AUTH_MODULES_.forEach(key=>{const level=value[key]||'none';if(!['none','view','edit'].includes(level))throw Error('Nivel de permiso inválido.');result[key]=level;});if(!AUTH_MODULES_.some(key=>result[key]!=='none'))throw Error('Selecciona al menos un módulo de consulta.');return result;}
function authReadableModules_(user){const modules=new Set();const refs={program:['courses','people','matrix','attendance'],dashboard:['program','courses','people','matrix','attendance','instructors','cmcap'],courses:['instructors','people','matrix'],matrix:['courses','people'],people:['matrix'],instructors:['people','courses','matrix','cmcap'],attendance:['courses','instructors','people','matrix','cmcap'],cmcap:['people'],reports:['program','courses','people','instructors','matrix','attendance','cmcap']};AUTH_MODULES_.forEach(key=>{if(authCan_(user,key,false)){modules.add(key);(refs[key]||[]).forEach(ref=>modules.add(ref));}});return modules;}
function authFilterState_(result,user){if(user.role==='admin')return result;const readable=authReadableModules_(user),state={};Object.keys(result.state).forEach(key=>{if(readable.has(AUTH_COLLECTION_MODULES_[key]))state[key]=result.state[key];});const out={...result,state};if(result.legacy){const names={empleados:'people',puestos:'matrix',cursos:'courses',instructores:'instructors',cmcap:'cmcap',catalogos:'matrix'};out.legacy={};Object.keys(names).forEach(key=>{if(readable.has(names[key]))out.legacy[key]=result.legacy[key];});}return out;}
function authPublic_(user){return {id:user.id,username:user.username,name:user.name,role:user.role,active:user.active,permissions:authPermissions_(user)};}
function authUsername_(value){const name=String(value||'').trim().toLowerCase();if(!/^[a-z0-9._-]{3,60}$/.test(name))throw Error('El usuario debe tener de 3 a 60 caracteres: letras sin acentos, números, punto, guion o guion bajo.');return name;}
function authCredential_(input){if(!input||!/^[a-f0-9]{32}$/.test(input.salt)||!/^[a-f0-9]{64}$/.test(input.key))throw Error('Credencial inválida. Vuelve a escribir la contraseña.');return {salt:input.salt,verifier:authVerifier_(input.key,input.salt)};}
function authLocked_(action){const lock=LockService.getScriptLock();lock.waitLock(30000);try{return action();}finally{lock.releaseLock();}}
function authSession_(user){const token=Utilities.getUuid()+Utilities.getUuid(),expires=Date.now()+6*60*60*1000;CacheService.getScriptCache().put('auth-session-'+authHash_(token),JSON.stringify({id:user.id,version:user.version,expires}),21600);return {token,expires,user:authPublic_(user)};}
function authRequire_(token,admin){if(typeof token!=='string'||token.length>200)throw Error('AUTH_REQUIRED: Inicia sesión para continuar.');const raw=CacheService.getScriptCache().get('auth-session-'+authHash_(token));if(!raw)throw Error('AUTH_REQUIRED: Tu sesión terminó. Inicia sesión de nuevo.');const session=JSON.parse(raw),user=authUsers_().find(item=>item.id===session.id);if(!user||!user.active||user.version!==session.version||session.expires<=Date.now())throw Error('AUTH_REQUIRED: Tu acceso cambió. Inicia sesión de nuevo.');if(admin&&user.role!=='admin')throw Error('Solo Recursos Humanos con rol de administrador puede gestionar usuarios.');return user;}
function prepararAccesoSAMARA(){
  const owner=Session.getEffectiveUser().getEmail(),actor=Session.getActiveUser().getEmail();if(!owner||actor!==owner)throw Error('Ejecuta esta función desde el editor de Apps Script con la cuenta propietaria.');
  authLocked_(()=>{if(authUsers_().length)throw Error('Los usuarios ya están configurados. Usa el panel Usuarios.');const code=Utilities.getUuid()+Utilities.getUuid();authProps_().setProperty('SAMARA_SETUP',JSON.stringify({hash:authHash_(code),expires:Date.now()+30*60*1000}));authSecret_();Logger.log('Código de configuración (vence en 30 minutos, un solo uso): '+code);});
}
function api_authStatus(){return {configured:authUsers_().length>0,iterations:AUTH_ITERATIONS_};}
function api_authChallenge(username){const name=String(username||'').trim().toLowerCase().slice(0,60),user=authUsers_().find(item=>item.username===name);return {salt:user?user.salt:authHash_(authSecret_()+name).slice(0,32),iterations:AUTH_ITERATIONS_};}
function authThrottle_(name){const cache=CacheService.getScriptCache(),key='auth-fail-'+authHash_(name),raw=cache.get(key),state=raw?JSON.parse(raw):{count:0};if(state.count>=5)throw Error('Demasiados intentos. Espera 15 minutos o solicita un cambio de contraseña a Recursos Humanos.');return {cache,key,state};}
function api_authLogin(username,key){return authLocked_(()=>{const name=String(username||'').trim().toLowerCase().slice(0,60),limit=authThrottle_(name),user=authUsers_().find(item=>item.username===name);const valid=typeof key==='string'&&/^[a-f0-9]{64}$/.test(key)&&user&&user.active&&authEqual_(user.verifier,authVerifier_(key,user.salt));if(!valid){limit.state.count++;limit.cache.put(limit.key,JSON.stringify(limit.state),900);throw Error('Usuario o contraseña incorrectos.');}limit.cache.remove(limit.key);return authSession_(user);});}
function api_authSetup(code,adminCredential,coordinatorCredential){return authLocked_(()=>{const limit=authThrottle_('initial-setup');const setup=JSON.parse(authProps_().getProperty('SAMARA_SETUP')||'null');if(authUsers_().length||!setup||setup.expires<Date.now()||!authEqual_(setup.hash,authHash_(String(code||'')))){limit.state.count++;limit.cache.put(limit.key,JSON.stringify(limit.state),900);throw Error('Código inválido, vencido o configuración ya realizada.');}const admin=authCredential_(adminCredential),coordinator=authCredential_(coordinatorCredential);const users=[{id:Utilities.getUuid(),username:'recursos.humanos',name:'RECURSOS HUMANOS',role:'admin',active:true,version:1,...admin},{id:Utilities.getUuid(),username:'coordinador.cmcap',name:'COORDINADOR CMCAP',role:'coordinator',active:true,version:1,...coordinator}];const props={};users.forEach(user=>props[AUTH_USERS_PREFIX_+user.id]=JSON.stringify(user));authProps_().setProperties(props);authProps_().deleteProperty('SAMARA_SETUP');limit.cache.remove(limit.key);return authSession_(users[0]);});}
function api_authMe(token){return authPublic_(authRequire_(token));}
function api_authLogout(token){if(typeof token==='string')CacheService.getScriptCache().remove('auth-session-'+authHash_(token));return true;}
function api_authPage(token){authRequire_(token);authRendering_=true;try{const t=HtmlService.createTemplateFromFile('Index');t.initialView='dashboard';t.appUrl=ScriptApp.getService().getUrl();return t.evaluate().getContent();}finally{authRendering_=false;}}
function api_usersList(token){authRequire_(token,true);return authUsers_().map(authPublic_);}
function api_usersSave(input,token){return authLocked_(()=>{const actor=authRequire_(token,true);input=input||{};const users=authUsers_(),previous=users.find(user=>user.id===input.id);if(input.id&&!previous)throw Error('El usuario ya no existe.');const username=authUsername_(input.username),name=String(input.name||'').trim().toUpperCase();if(!name||name.length>120)throw Error('Escribe un nombre de hasta 120 caracteres.');if(!['admin','coordinator'].includes(input.role))throw Error('Rol inválido.');if(users.some(user=>user.username===username&&user.id!==input.id))throw Error('Ese usuario ya existe.');if(previous&&previous.id===actor.id&&(input.active===false||input.role!=='admin'))throw Error('No puedes desactivar ni quitar tu propio acceso de administración.');if(!previous&&users.length>=100)throw Error('Límite de 100 usuarios.');if((!previous||previous.username!==username)&&!input.credential)throw Error('Asigna una contraseña al crear o cambiar el usuario de acceso.');if(previous&&previous.role==='admin'&&(input.active===false||input.role!=='admin')&&!users.some(user=>user.id!==previous.id&&user.role==='admin'&&user.active))throw Error('Debe quedar al menos un administrador activo.');const credential=input.credential?authCredential_(input.credential):null,user={...(previous||{}),id:previous?previous.id:Utilities.getUuid(),username,name,role:input.role,permissions:authValidatePermissions_(input.permissions,input.role,previous),active:input.active!==false,version:(previous?previous.version:0)+1,...(credential||{})};authProps_().setProperty(AUTH_USERS_PREFIX_+user.id,JSON.stringify(user));CacheService.getScriptCache().remove('auth-fail-'+authHash_(username));return authPublic_(user);});}
function api_usersDelete(id,token){return authLocked_(()=>{const actor=authRequire_(token,true);if(id===actor.id)throw Error('No puedes eliminar tu propio usuario.');const users=authUsers_(),target=users.find(user=>user.id===id);if(!target)throw Error('El usuario ya no existe.');if(target.role==='admin'&&target.active&&!users.some(user=>user.id!==id&&user.role==='admin'&&user.active))throw Error('Debe quedar un administrador activo.');notificationDelete_(target);authProps_().deleteProperty(AUTH_USERS_PREFIX_+id);return true;});}
function prepararRecuperacionSAMARA(){const owner=Session.getEffectiveUser().getEmail();if(!owner||Session.getActiveUser().getEmail()!==owner)throw Error('Ejecuta esta función desde el editor con la cuenta propietaria.');authLocked_(()=>{if(!authUsers_().length)throw Error('Primero configura los usuarios iniciales.');const code=Utilities.getUuid()+Utilities.getUuid();authProps_().setProperty('SAMARA_RECOVERY',JSON.stringify({hash:authHash_(code),expires:Date.now()+30*60*1000}));Logger.log('Código de recuperación administrativa (30 minutos, un solo uso): '+code);});}
function api_authRecovery(code,username,credential){return authLocked_(()=>{const limit=authThrottle_('admin-recovery'),recovery=JSON.parse(authProps_().getProperty('SAMARA_RECOVERY')||'null'),user=authUsers_().find(item=>item.username===String(username||'').trim().toLowerCase()&&item.role==='admin');if(!user||!recovery||recovery.expires<Date.now()||!authEqual_(recovery.hash,authHash_(String(code||'')))){limit.state.count++;limit.cache.put(limit.key,JSON.stringify(limit.state),900);throw Error('Código o usuario administrador inválido, vencido o ya utilizado.');}const next={...user,...authCredential_(credential),active:true,version:user.version+1};authProps_().setProperty(AUTH_USERS_PREFIX_+user.id,JSON.stringify(next));authProps_().deleteProperty('SAMARA_RECOVERY');limit.cache.remove(limit.key);limit.cache.remove('auth-fail-'+authHash_(user.username));return authSession_(next);});}

// Une las lecturas iniciales en una llamada y evita recargar todo el iframe al salir.
function api_authResume(token){const user=authRequire_(token);return {user:authPublic_(user),html:api_authPage(token),bootstrap:api_loadAppState(token)};}
function api_authEnter(username,key){const session=api_authLogin(username,key);return {...session,...api_authResume(session.token)};}
function api_authLogoutPage(token){api_authLogout(token);return HtmlService.createHtmlOutputFromFile('Acceso').getContent();}

// Lecturas privadas por usuario; no cambian las colecciones ni su revisión.
function notificationPrefix_(user){return 'SAMARA_NOTICE_'+user.id+'_';}
function notificationReads_(user){const props=authProps_(),prefix=notificationPrefix_(user),count=Number(props.getProperty(prefix+'COUNT'))||0,result={};for(let i=0;i<count;i++)Object.assign(result,JSON.parse(props.getProperty(prefix+i)||'{}'));return result;}
function notificationWrite_(user,state){const props=authProps_(),prefix=notificationPrefix_(user),oldCount=Number(props.getProperty(prefix+'COUNT'))||0,entries=Object.entries(state),next={};let count=0;for(let i=0;i<entries.length;i+=60)next[prefix+count++]=JSON.stringify(Object.fromEntries(entries.slice(i,i+60)));next[prefix+'COUNT']=String(count);props.setProperties(next);for(let i=count;i<oldCount;i++)props.deleteProperty(prefix+i);}
function notificationDelete_(user){const props=authProps_(),prefix=notificationPrefix_(user),count=Number(props.getProperty(prefix+'COUNT'))||0;for(let i=0;i<count;i++)props.deleteProperty(prefix+i);props.deleteProperty(prefix+'COUNT');}
function api_notificationRead(records,activeIds,token){if(typeof activeIds==='string'&&token===undefined){token=activeIds;activeIds=null;}return authLocked_(()=>{const actor=authRequire_(token);if(!Array.isArray(records)||!records.length||records.length>100)throw Error('Avisos inválidos.');for(const item of records){if(!item||!/^((course|list|cmcap):)[a-f0-9]{16}$/.test(item.id)||!/^[a-f0-9]{16}$/.test(item.version)||!['program','courses','attendance','cmcap'].includes(item.module)||typeof item.read!=='boolean')throw Error('Aviso inválido.');if(!authCan_(actor,item.module,false))throw Error('PERMISSION_DENIED: No tienes acceso a este aviso.');}if(activeIds!=null&&(!Array.isArray(activeIds)||activeIds.length>10000||activeIds.some(id=>!/^((course|list|cmcap):)[a-f0-9]{16}$/.test(id))))throw Error('Listado de avisos inválido.');const state=notificationReads_(actor);if(activeIds){const active=new Set(activeIds);Object.keys(state).forEach(id=>{if(!active.has(id))delete state[id];});}for(const item of records){if(item.read)state[item.id]={version:item.version,at:Date.now()};else delete state[item.id];}notificationWrite_(actor,state);return {readState:state};});}
